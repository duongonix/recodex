{
  "name": "recodex",
  "version": "0.1.3",
  "description": "Lightweight desktop screen recorder and screenshot app",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
