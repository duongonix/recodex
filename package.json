    "svelte-check": "^4.7.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
